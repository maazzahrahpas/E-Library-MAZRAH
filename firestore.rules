rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true && (
        request.auth.token.email == 'ma.azzahrahpas@gmail.com' ||
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email.matches('.*@mazzahrah\\.sch\\.id'))
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrapAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isBootstrapAdmin() || (isAdmin() && isValidId(adminId));
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && (
        isAdmin() ||
        isBootstrapAdmin() ||
        (isOwner(userId) && request.resource.data.role == 'siswa')
      );
      allow update: if isSignedIn() && isValidId(userId) && (
        isAdmin() ||
        isBootstrapAdmin() ||
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Books Collection
    match /books/{bookId} {
      allow read: if true; // Public catalog viewable by all students & visitors
      allow create, delete: if isAdmin() && isValidId(bookId);
      allow update: if isValidId(bookId) && (
        isAdmin() ||
        (
          isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availableCopies']) &&
          request.resource.data.availableCopies is number &&
          request.resource.data.availableCopies >= 0 &&
          request.resource.data.availableCopies <= resource.data.totalCopies
        )
      );
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(categoryId);
    }

    // Borrowings Collection
    match /borrowings/{borrowId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(borrowId) && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(borrowId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() && isValidId(borrowId);
    }

    // Reading History Collection
    match /reading_history/{historyId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(historyId) && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() && isValidId(historyId) && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Favorites Collection
    match /favorites/{favId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(favId) && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() && isValidId(favId) && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(reviewId) && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() && isValidId(reviewId) && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all' || isAdmin());
      allow create: if isSignedIn() && isValidId(notifId);
      allow update, delete: if isSignedIn() && isValidId(notifId) && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Announcements Collection
    match /announcements/{annId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(annId);
    }

    // Literacy Challenges Collection
    match /challenges/{challengeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(challengeId);
    }

    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if false; // Immutable audit log
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(settingId);
      allow delete: if isAdmin() && isValidId(settingId);
    }
  }
}
